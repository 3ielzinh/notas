# ARQUIVO DE EXEMPLO PARA PRODUÇÃO
# Copie para .env e ajuste os valores

# Django
DEBUG=False
SECRET_KEY=GERE_UMA_CHAVE_SEGURA_AQUI
ALLOWED_HOSTS=seu-dominio.gov.br,ip-do-servidor

# Database PostgreSQL
DB_NAME=django_notas
DB_USER=postgres
DB_PASSWORD=SENHA_FORTE_AQUI
DB_HOST=db
DB_PORT=5432

# Security (SSL/HTTPS em produção)
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True

# Environment
ENVIRONMENT=production